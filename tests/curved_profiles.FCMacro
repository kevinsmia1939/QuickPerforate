"""Run in FreeCAD as a macro; writes JSONL results to the system temporary directory.

Tests 16 profiles x 5 arrangements x 3 surfaces x 2 partial-hole modes.
The macro closes only the document it creates and leaves FreeCAD running.
"""
import os,time,json,traceback,tempfile,FreeCAD as A,Part
from freecad.QuickPerforate import QuickPerforate as Q
D=A.newDocument('Matrix');sk=D.addObject('Sketcher::SketchObject','Profile')
for x,r in [(-1, .7),(1,.7),(-1,.3)]:sk.addGeometry(Part.Circle(A.Vector(x,0,0),A.Vector(0,0,1),r),False)
D.recompute()
# Trimmed curved faces exercise real boundaries, unlike a complete periodic surface.
c=Part.makeCylinder(12,14,A.Vector(),A.Vector(0,0,1),110)
s=Part.makeSphere(12,A.Vector(),A.Vector(0,0,1),-35,35,110)
report=os.path.join(tempfile.gettempdir(),'quickperforate_curved_profiles.jsonl')
t=Part.makeTorus(12,4,A.Vector(),A.Vector(0,0,1),-60,60,110)
torus_type=type(next(f for f in t.Faces if type(f.Surface).__name__ in ('Toroid','Torus')).Surface)
log=open(report,'w',buffering=1)
for label,solid,typ in [('Cylinder',c,Part.Cylinder),('Sphere',s,Part.Sphere),('Torus',t,torus_type)]:
 face=next(f for f in solid.Faces if isinstance(f.Surface,typ))
 for partial in (False,True):
  for pattern in Q.ARRANGEMENTS:
   for shape in Q.HOLE_SHAPES:
    record=dict(surface=label,partial=partial,pattern=pattern,shape=shape)
    start=time.perf_counter()
    try:
     profile=Q.sketch_profile(sk,3) if shape=='Custom Sketch' else None
     result,n=Q.perforate_faces(solid,[face],pattern,shape,9,3,.3,depth=1,size2=1.5 if shape=='Slot' else 0,pitch_y=7,row_offset=3,partial_holes=partial,custom_profile=profile)
     assert not result.isNull() and result.isValid(),'invalid shape'
     assert result.Volume < solid.Volume-1e-6,'no material removed'
     assert n>0,'no placements'
     record.update(status='PASS',count=n,volume=result.Volume)
    except Exception:record.update(status='FAIL',error=traceback.format_exc())
    record['seconds']=time.perf_counter()-start;log.write(json.dumps(record)+'\n')
log.close()
A.closeDocument(D.Name)
A.Console.PrintMessage('Curved profile test results: '+report+'\n')
